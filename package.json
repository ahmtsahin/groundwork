{
  "name": "groundwork",
  "version": "0.6.0",
  "description": "Groundwork: a Claude Code and Codex plugin whose settle skill closes every material decision through host-native question rounds before implementing.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node test/native-app-server-smoke.mjs",
    "native:doctor": "node scripts/native-mode-doctor.mjs",
    "native:probe": "node scripts/native-live-probe.mjs",
    "eval:doctor": "node eval/src/run.mjs doctor",
    "eval": "node eval/src/run.mjs run",
    "eval:compare": "node eval/src/compare.mjs",
    "eval:summary": "node eval/src/summarize.mjs",
    "validate": "npm run check && npm test && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}
